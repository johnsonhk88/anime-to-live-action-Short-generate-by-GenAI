# LLM Model for the Deep Agents pipeline coordinator
# Format: provider:model (e.g., google_genai:gemini-3.5-flash, openai:gpt-5.5, anthropic:claude-sonnet-4-6)
AGENT_MODEL=google_genai:gemini-3.5-flash

# Execution Mode: local / cloud / hybrid
DEFAULT_MODE=hybrid

# Maximum regeneration iterations in the quality review loop
MAX_PIPELINE_ITERATIONS=3

# --- API Keys (set at least the one matching your AGENT_MODEL) ---

# Google Gemini (required for google_genai:* models)
# GOOGLE_API_KEY=your-google-api-key

# OpenAI (required for openai:* models)
# OPENAI_API_KEY=your-openai-api-key

# Anthropic (required for anthropic:* models)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- LangSmith Tracing (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
