# Workflow UI talks to this API. MOCK_PROVIDERS=true = chat bible without GPUs/keys.
# Execution Mode: local / cloud / hybrid (engine defaults for jobs + coordinator)
DEFAULT_MODE=hybrid

# Dry-run without calling real providers (tools return structured mock data)
MOCK_PROVIDERS=false

# Maximum regeneration iterations in the quality review loop
MAX_PIPELINE_ITERATIONS=3

OUTPUT_DIR=./data/outputs
DATABASE_URL=sqlite:///./data/workflow.db
# DATABASE_URL=postgresql+psycopg2://anime:anime@localhost:5432/anime_workflow

# --- Optional per-slot overrides (empty = use mode defaults) ---
# LLM_PROFILE=lmstudio          # lmstudio | vllm | vllm_omni | sglang | strata | ollama | openrouter | grok | opencode_go | github_copilot
# LLM_MODEL=
# LLM_BASE_URL=
# IMAGE_PROVIDER=vllm_omni      # vllm_omni | sglang_diffusion | comfyui | gpt_image_2 | nano_banana_2
# IMAGE_MODEL=qwen-image
# VIDEO_PROVIDER=seedance_2.5   # seedance_2.5 | minimax_h3 | ltx_2.5 | veo
# TTS_PROFILE=qwen3_tts         # qwen3_tts | cosyvoice3 | comfy_tts | openai_speech | none
# TTS_ENABLED=true

# --- Seedance 2.5 (cloud video only; hybrid defaults to local MiniMax H3) ---
SEEDANCE_BACKEND=openrouter     # openrouter | direct
# SEEDANCE_MODEL=bytedance/seedance-2.5
# SEEDANCE_BASE_URL=            # required when SEEDANCE_BACKEND=direct
# SEEDANCE_API_KEY=             # required when SEEDANCE_BACKEND=direct

# --- Local engine URLs ---
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_OMNI_BASE_URL=http://127.0.0.1:8091/v1
SGLANG_BASE_URL=http://127.0.0.1:30000/v1
SGLANG_DIFFUSION_BASE_URL=http://127.0.0.1:30000/v1
STRATA_BASE_URL=http://127.0.0.1:8080/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
COMFYUI_BASE_URL=http://127.0.0.1:8188

# --- Cloud URLs ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROK_BASE_URL=https://api.x.ai/v1
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/v1
GITHUB_COPILOT_BASE_URL=https://api.githubcopilot.com

# --- API keys (only those matching active slots) ---
# Hybrid default: OPENROUTER_API_KEY for cheap LLM. Video is local minimax_h3 (no Seedance).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=               # GPT Image 2 / openai_speech
# XAI_API_KEY=                  # Grok
# OPENCODE_API_KEY=             # OpenCode Go
# GOOGLE_API_KEY=               # Nano Banana 2 / optional Veo
# GITHUB_TOKEN=                 # GitHub Copilot
# STRATA_API_KEY=               # Strata local engine
# ANTHROPIC_API_KEY=

# --- LangSmith Tracing (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
